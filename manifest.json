{
  "manifest_version": 3,
  "name": "Show Keys",
  "version": "1.0.0",
  "description": "Shows the keys you press at the bottom center of the page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Show Keys",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "themes.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/mailtokamalnayan/show-keys"
}
