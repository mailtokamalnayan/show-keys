{
  "manifest_version": 3,
  "name": "Show Keys",
  "version": "1.0.0",
  "description": "Shows the keys you press at the bottom center of the page.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Show Keys" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
